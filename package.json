{
  "name": "circuit-router",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/content",
    "apps/game"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/game",
    "build": "npm run build --workspace apps/game",
    "preview": "npm run preview --workspace apps/game",
    "test": "vitest run --config vitest.workspace.ts",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/content/tsconfig.json && tsc --noEmit -p apps/game/tsconfig.json"
  },
  "devDependencies": {
    "jsdom": "^29.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
